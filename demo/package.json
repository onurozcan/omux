{
  "name": "omux-demo",
  "version": "1.0.0",
  "private": true,
  "description": "omux intro and hype videos, rendered with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts OmuxIntro out/omux-intro.mp4",
    "render:webm": "remotion render src/index.ts OmuxIntro out/omux-intro.webm --codec=vp8",
    "render:hype": "remotion render src/index.ts OmuxHype out/omux-hype.mp4",
    "render:hype:webm": "remotion render src/index.ts OmuxHype out/omux-hype.webm --codec=vp8",
    "render:story": "remotion render src/index.ts OmuxStory out/omux-story.mp4",
    "render:story:webm": "remotion render src/index.ts OmuxStory out/omux-story.webm --codec=vp8",
    "render:stars": "remotion render src/index.ts OmuxStars out/omux-stars.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.300",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.300"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
